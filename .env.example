NODE_ENV=production
PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# Redis: Use REDIS_URL for Cloud platforms (e.g., Upstash, Redis Cloud, Render, Railway)
REDIS_URL=rediss://default:<password>@<host>:<port>
# Or separate host/port/password:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
JWT_SECRET=your_jwt_secret_key_at_least_32_chars
GROQ_API_KEY=your_groq_api_key
LOG_LEVEL=info
ALLOWED_ORIGINS=https://your-frontend-domain.com,http://localhost:5173
TRUST_PROXY=1
GROQ_TUTOR_CONCURRENCY=15

# Cloudinary CDN Configuration (Optional - falls back to local static storage if not provided)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Seed Demo Passwords (only used in non-production seed scripts)
DEMO_ADMIN_PASSWORD=your_demo_admin_password
DEMO_STUDENT_PASSWORD=your_demo_student_password
SUPERADMIN_PASSWORD=your_superadmin_password
