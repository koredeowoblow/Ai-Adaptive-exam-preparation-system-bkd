    "@types/node": "^26.5.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "artillery": "^2.0.34",
    "axios": "^1.20.0",
    "ioredis-mock": "^8.13.1",
    "jest": "^30.5.1",
    "mongodb-memory-server": "^11.2.0",
