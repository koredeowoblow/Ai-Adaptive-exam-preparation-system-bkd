    "test:load:practice": "artillery run load-tests/practice-session.yml -o load-tests/reports/practice.json && artillery report load-tests/reports/practice.json",
    "test:load:read": "artillery run load-tests/read-heavy.yml -o load-tests/reports/read.json && artillery report load-tests/reports/read.json",
    "test:load:mixed": "artillery run load-tests/mixed-realistic.yml -o load-tests/reports/mixed.json && artillery report load-tests/reports/mixed.json",
    "test:load:grading-burst": "ts-node load-tests/theory-grading-burst.ts",
    "test:load:all": "npm run test:load:auth && npm run test:load:practice && npm run test:load:read && npm run test:load:mixed && npm run test:load:grading-burst",
    "generate:load-tokens": "ts-node load-tests/generate-tokens.ts",
    "audit:adaptation": "ts-node load-tests/audit-adaptation-logic.ts",
    "audit:edge-cases": "ts-node load-tests/audit-edge-cases.ts",
    "audit:scoring": "ts-node load-tests/audit-scoring-integrity.ts",
    "audit:cache": "ts-node load-tests/audit-payload-cache.ts",
    "audit:concurrency": "ts-node load-tests/audit-concurrency.ts",
    "audit:full": "ts-node load-tests/run-audit.ts"
  },
